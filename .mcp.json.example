{
  "mcpServers": {
    "github_standalone": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer <yourtokenhere>",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "issues,repos,actions"
      }
    },
    "exa_standalone": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    }
  }
}
